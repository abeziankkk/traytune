<Window x:Class="TrayTune.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки TrayTune"
        Width="440" MaxHeight="720" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#0DFFFFFF"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF8E8EA0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="Option" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFF0F0F6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Check" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFF0F0F6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FF4ADE80"/>
            <Setter Property="Foreground" Value="#FF0E0E12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Width" Value="130"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFD8D8E4"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Width" Value="110"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent"
                                BorderBrush="#26FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" Background="#FF16161D" BorderBrush="#2EFFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.55" Color="#FF000000"/>
        </Border.Effect>

        <StackPanel Margin="18,16,18,16">
            <!-- Шапка -->
            <Grid Margin="2,0,0,14" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock Text="Настройки" FontSize="17" FontWeight="SemiBold" Foreground="#FFF5F5FA"/>
                    <TextBlock Text="TrayTune" FontSize="11" Foreground="#FF6E6E82" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Content="✕" HorizontalAlignment="Right" Width="26" Height="26" FontSize="11"
                        Style="{StaticResource GhostButton}" Click="Cancel_Click"/>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
                <StackPanel>
                    <!-- Положение -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="ПОЛОЖЕНИЕ В ПАНЕЛИ" Style="{StaticResource CardTitle}"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="PlacementLeft" Style="{StaticResource Option}" Content="Слева"
                                             GroupName="Placement" Checked="Placement_Checked"/>
                                <RadioButton x:Name="PlacementCenter" Style="{StaticResource Option}" Content="По центру"
                                             GroupName="Placement" Checked="Placement_Checked"/>
                                <RadioButton x:Name="PlacementRight" Style="{StaticResource Option}" Content="Справа"
                                             GroupName="Placement" Checked="Placement_Checked"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Фон -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="ФОН" Style="{StaticResource CardTitle}"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="BgTransparent" Style="{StaticResource Option}" Content="Прозрачный"
                                             GroupName="Background" Checked="Background_Checked"/>
                                <RadioButton x:Name="BgTranslucent" Style="{StaticResource Option}" Content="Полупрозрачный"
                                             GroupName="Background" Checked="Background_Checked"/>
                                <RadioButton x:Name="BgSolid" Style="{StaticResource Option}" Content="Тёмный"
                                             GroupName="Background" Checked="Background_Checked"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Цвет -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="ЦВЕТ АКЦЕНТА" Style="{StaticResource CardTitle}"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="AccentAuto" Style="{StaticResource Option}" Content="Авто"
                                             GroupName="Accent" Checked="Accent_Checked"/>
                                <RadioButton x:Name="AccentSpotify" Style="{StaticResource Option}" Content="Spotify"
                                             GroupName="Accent" Checked="Accent_Checked"/>
                                <RadioButton x:Name="AccentYandex" Style="{StaticResource Option}" Content="Яндекс"
                                             GroupName="Accent" Checked="Accent_Checked"/>
                                <RadioButton x:Name="AccentWave" Style="{StaticResource Option}" Content="Волна"
                                             GroupName="Accent" Checked="Accent_Checked"/>
                                <RadioButton x:Name="AccentOther" Style="{StaticResource Option}" Content="Другой"
                                             GroupName="Accent" Checked="Accent_Checked"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Ширина -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="ШИРИНА" Style="{StaticResource CardTitle}"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="WidthNarrow" Style="{StaticResource Option}" Content="Узкая"
                                             GroupName="Width" Checked="Width_Checked"/>
                                <RadioButton x:Name="WidthNormal" Style="{StaticResource Option}" Content="Обычная"
                                             GroupName="Width" Checked="Width_Checked"/>
                                <RadioButton x:Name="WidthWide" Style="{StaticResource Option}" Content="Широкая"
                                             GroupName="Width" Checked="Width_Checked"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Поведение -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="ПОВЕДЕНИЕ" Style="{StaticResource CardTitle}"/>
                            <CheckBox x:Name="ShowProgressCheck" Style="{StaticResource Check}" Content="Показывать полосу прогресса"/>
                            <CheckBox x:Name="DockedCheck" Style="{StaticResource Check}" Content="Встроить в панель задач"/>
                            <CheckBox x:Name="AutostartCheck" Style="{StaticResource Check}" Content="Запускать при входе в Windows" Margin="0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Кнопки -->
            <StackPanel Margin="0,4,0,0">
                <TextBlock x:Name="HintText" FontSize="10.5" Foreground="#FF6E6E82"
                           Margin="2,0,0,8" TextWrapping="Wrap"
                           Text="Изменения применяются сразу после сохранения"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Click="Cancel_Click"/>
                    <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
