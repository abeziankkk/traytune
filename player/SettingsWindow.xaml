<Window x:Class="TrayTune.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TrayTune"
        Title="Настройки TrayTune"
        Width="440" MaxHeight="840" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#0DFFFFFF"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF8E8EA0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="Option" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFF0F0F6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Check" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFF0F0F6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FF4ADE80"/>
            <Setter Property="Foreground" Value="#FF0E0E12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Width" Value="130"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFD8D8E4"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Width" Value="110"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent"
                                BorderBrush="#26FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" Background="#FF16161D" BorderBrush="#2EFFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.55" Color="#FF000000"/>
        </Border.Effect>

        <StackPanel Margin="18,16,18,16">
            <!-- Шапка -->
            <Grid Margin="2,0,0,14" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock Text="{loc:Loc settings.title}" FontSize="17" FontWeight="SemiBold" Foreground="#FFF5F5FA"/>
                    <TextBlock Text="TrayTune" FontSize="11" Foreground="#FF6E6E82" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Content="✕" HorizontalAlignment="Right" Width="26" Height="26" FontSize="11"
                        Style="{StaticResource GhostButton}" Click="Cancel_Click"/>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
                <StackPanel>
                    <!-- Положение -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc settings.card.placement}" Style="{StaticResource CardTitle}"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="PlacementLeft" Style="{StaticResource Option}" Content="{loc:Loc placement.left}"
                                             GroupName="Placement" Checked="Placement_Checked"/>
                                <RadioButton x:Name="PlacementCenter" Style="{StaticResource Option}" Content="{loc:Loc placement.center}"
                                             GroupName="Placement" Checked="Placement_Checked"/>
                                <RadioButton x:Name="PlacementRight" Style="{StaticResource Option}" Content="{loc:Loc placement.right}"
                                             GroupName="Placement" Checked="Placement_Checked"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Фон -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc settings.card.background}" Style="{StaticResource CardTitle}"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="BgTransparent" Style="{StaticResource Option}" Content="{loc:Loc bg.transparent}"
                                             GroupName="Background" Checked="Background_Checked"/>
                                <RadioButton x:Name="BgTranslucent" Style="{StaticResource Option}" Content="{loc:Loc bg.translucent}"
                                             GroupName="Background" Checked="Background_Checked"/>
                                <RadioButton x:Name="BgSolid" Style="{StaticResource Option}" Content="{loc:Loc bg.solid}"
                                             GroupName="Background" Checked="Background_Checked"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Цвет -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc settings.card.accent}" Style="{StaticResource CardTitle}"/>
                            <WrapPanel>
                                <RadioButton x:Name="AccentAuto" Style="{StaticResource Option}" Content="{loc:Loc accent.auto}"
                                             GroupName="Accent" Checked="Accent_Checked"/>
                                <RadioButton x:Name="AccentSpotify" Style="{StaticResource Option}" Content="Spotify"
                                             GroupName="Accent" Checked="Accent_Checked"/>
                                <RadioButton x:Name="AccentYandex" Style="{StaticResource Option}" Content="{loc:Loc accent.yandex}"
                                             GroupName="Accent" Checked="Accent_Checked"/>
                                <RadioButton x:Name="AccentWave" Style="{StaticResource Option}" Content="{loc:Loc accent.wave}"
                                             GroupName="Accent" Checked="Accent_Checked"/>
                                <RadioButton x:Name="AccentCover" Style="{StaticResource Option}" Content="{loc:Loc accent.cover}"
                                             GroupName="Accent" Checked="Accent_Checked"/>
                                <RadioButton x:Name="AccentOther" Style="{StaticResource Option}" Content="{loc:Loc accent.other}"
                                             GroupName="Accent" Checked="Accent_Checked"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Ширина -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc settings.card.width}" Style="{StaticResource CardTitle}"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="WidthNarrow" Style="{StaticResource Option}" Content="{loc:Loc width.narrow}"
                                             GroupName="Width" Checked="Width_Checked"/>
                                <RadioButton x:Name="WidthNormal" Style="{StaticResource Option}" Content="{loc:Loc width.normal}"
                                             GroupName="Width" Checked="Width_Checked"/>
                                <RadioButton x:Name="WidthWide" Style="{StaticResource Option}" Content="{loc:Loc width.wide}"
                                             GroupName="Width" Checked="Width_Checked"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Поведение -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc settings.card.behavior}" Style="{StaticResource CardTitle}"/>
                            <CheckBox x:Name="ShowProgressCheck" Style="{StaticResource Check}" Content="{loc:Loc behavior.progress}"/>
                            <CheckBox x:Name="MarqueeCheck" Style="{StaticResource Check}" Content="{loc:Loc behavior.marquee}"/>
                            <CheckBox x:Name="DockedCheck" Style="{StaticResource Check}" Content="{loc:Loc behavior.docked}"/>
                            <CheckBox x:Name="AutostartCheck" Style="{StaticResource Check}" Content="{loc:Loc behavior.autostart}"/>
                            <CheckBox x:Name="VolumeWheelCheck" Style="{StaticResource Check}" Content="{loc:Loc behavior.volume}" Margin="0"/>
                        </StackPanel>
                    </Border>

                    <!-- Язык -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc settings.card.language}" Style="{StaticResource CardTitle}"/>
                            <WrapPanel>
                                <RadioButton x:Name="LangAuto" Style="{StaticResource Option}"
                                             Content="{loc:Loc language.auto}"
                                             GroupName="Language" Checked="Language_Checked"/>
                                <RadioButton x:Name="LangRu" Style="{StaticResource Option}" Content="Русский"
                                             GroupName="Language" Checked="Language_Checked"/>
                                <RadioButton x:Name="LangEn" Style="{StaticResource Option}" Content="English"
                                             GroupName="Language" Checked="Language_Checked"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Обновления -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc settings.card.updates}" Style="{StaticResource CardTitle}"/>
                            <CheckBox x:Name="CheckUpdatesCheck" Style="{StaticResource Check}"
                                      Content="{loc:Loc updates.check}" Margin="0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Кнопки -->
            <StackPanel Margin="0,4,0,0">
                <TextBlock x:Name="HintText" FontSize="10.5" Foreground="#FF6E6E82"
                           Margin="2,0,0,8" TextWrapping="Wrap"
                           Text="{loc:Loc settings.hint}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:Loc button.cancel}" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Click="Cancel_Click"/>
                    <Button Content="{loc:Loc button.save}" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
